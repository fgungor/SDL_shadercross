+static std::string InterfacePreservationModule(const std::string& interface) {
+  return R"(OpCapability Shader
+OpMemoryModel Logical GLSL450
+OpEntryPoint Fragment %main "main" )" + interface + R"(
+OpExecutionMode %main OriginUpperLeft
+OpName %main "main"
+OpName %unused_input "unused_input"
+OpName %color "color"
+OpName %out "out"
+OpName %unused_output "unused_output"
+OpName %position "position"
+OpName %resource "resource"
+OpName %float "float"
+OpName %v4float "v4float"
+OpName %block "block"
+OpName %input_ptr "input_ptr"
+OpName %output_ptr "output_ptr"
+OpName %uniform_ptr "uniform_ptr"
+OpName %void "void"
+OpName %fn "fn"
+OpName %entry "entry"
+OpName %value "value"
+OpDecorate %unused_input Location 0
+OpDecorate %color Location 1
+OpDecorate %out Location 0
+OpDecorate %unused_output Location 1
+OpDecorate %position BuiltIn FragCoord
+OpDecorate %block Block
+OpMemberDecorate %block 0 Offset 0
+OpDecorate %resource DescriptorSet 0
+OpDecorate %resource Binding 0
+%float = OpTypeFloat 32
+%v4float = OpTypeVector %float 4
+%block = OpTypeStruct %v4float
+%input_ptr = OpTypePointer Input %v4float
+%output_ptr = OpTypePointer Output %v4float
+%uniform_ptr = OpTypePointer Uniform %block
+%void = OpTypeVoid
+%fn = OpTypeFunction %void
+%unused_input = OpVariable %input_ptr Input
+%color = OpVariable %input_ptr Input
+%out = OpVariable %output_ptr Output
+%unused_output = OpVariable %output_ptr Output
+%position = OpVariable %input_ptr Input
+%resource = OpVariable %uniform_ptr Uniform
+%main = OpFunction %void None %fn
+%entry = OpLabel
+%value = OpLoad %v4float %color
+OpStore %out %value
+OpReturn
+OpFunctionEnd
+)";
+}
+
+TEST_F(RemoveUnusedInterfaceVariablesTest, PreserveUserInterfaceOnly) {
+  SetTargetEnv(SPV_ENV_UNIVERSAL_1_4);
+  const auto text = InterfacePreservationModule(
+      "%unused_input %color %out %unused_output %position %resource");
+  const auto expected_text = InterfacePreservationModule(
+      "%unused_input %color %out %unused_output");
+  SinglePassRunAndCheck<RemoveUnusedInterfaceVariablesPass>(
+      text, expected_text, true, true, true);
+}
+
+TEST_F(RemoveUnusedInterfaceVariablesTest, RemoveUserInterfaceByDefault) {
+  SetTargetEnv(SPV_ENV_UNIVERSAL_1_4);
+  const auto text = InterfacePreservationModule(
+      "%unused_input %color %out %unused_output %position %resource");
+  const auto expected_text = InterfacePreservationModule("%color %out");
+  SinglePassRunAndCheck<RemoveUnusedInterfaceVariablesPass>(
+      text, expected_text, true, true);
+}
